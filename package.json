{
  "name": "reactive-state-validator",
  "version": "0.0.1",
  "description": "A simple, fully typed, customizable reactive validator engine to validate your state with built-in rules or custom logic.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "keywords": [
    "Vue",
    "Vue3",
    "Validation",
    "Validator",
    "Forms",
    "Vue Forms",
    "State Validation",
    "Model Validation",
    "Vue Validation",
    "Vue State Validation",
    "Vue Model Validation"
  ],
  "author": "michaelolof",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelolof/vue3-state-validator.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@vue/reactivity": "^3.5.26",
    "typescript": "^5.8.2",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@vue/reactivity": "^3.5.26"
  }
}